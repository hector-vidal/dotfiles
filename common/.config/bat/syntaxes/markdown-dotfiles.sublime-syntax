%YAML 1.2
---
# Envoltorio del Markdown integrado de bat. bat (syntect) no admite `extends`,
# así que esta sintaxis añade sus reglas y delega el resto con `include`.
# Añade: frontmatter YAML al inicio del archivo y bloques de código de lenguajes
# que el Markdown integrado deja sin color.
# Límite: un bloque dentro de una lista o una cita lo resuelve el Markdown
# integrado, así que esos lenguajes salen planos ahí.
# Se activa con `--map-syntax='*.md:Markdown (dotfiles)'` en el config de bat.
name: Markdown (dotfiles)
scope: text.html.markdown.dotfiles

variables:
  fence_end: '^\s*(```)\s*$'

contexts:
  # Solo se mira la primera línea: syntect lee línea a línea y `\A` coincide al
  # inicio de cualquiera, así que un `---` del cuerpo reabriría el frontmatter.
  main:
    - match: '(?=^---\s*$)'
      set: [body, frontmatter]
    - match: ''
      set: body

  frontmatter:
    - match: '^(---)\s*$'
      captures:
        1: punctuation.definition.frontmatter.begin.markdown
      embed: scope:source.yaml
      embed_scope: meta.frontmatter.markdown
      escape: '^(---|\.\.\.)\s*$'
      escape_captures:
        1: punctuation.definition.frontmatter.end.markdown
    - match: ''
      pop: true

  body:
    - include: fence-julia
    - include: fence-yaml
    - include: fence-toml
    - include: fence-go
    - include: fence-lua
    - include: fence-swift
    - include: fence-dockerfile
    - include: fence-nginx
    - include: scope:text.html.markdown

  fence-julia:
    - match: '^\s*(```)\s*(julia)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.julia
      embed_scope: markup.raw.code-fence.julia.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}

  fence-yaml:
    - match: '^\s*(```)\s*(ya?ml)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.yaml
      embed_scope: markup.raw.code-fence.yaml.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}

  fence-toml:
    - match: '^\s*(```)\s*(toml)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.toml
      embed_scope: markup.raw.code-fence.toml.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}

  fence-go:
    - match: '^\s*(```)\s*(go(?:lang)?)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.go
      embed_scope: markup.raw.code-fence.go.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}

  fence-lua:
    - match: '^\s*(```)\s*(lua)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.lua
      embed_scope: markup.raw.code-fence.lua.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}

  fence-swift:
    - match: '^\s*(```)\s*(swift)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.swift
      embed_scope: markup.raw.code-fence.swift.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}

  fence-dockerfile:
    - match: '^\s*(```)\s*(dockerfile|docker)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.dockerfile
      embed_scope: markup.raw.code-fence.dockerfile.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}

  fence-nginx:
    - match: '^\s*(```)\s*(nginx)\s*$'
      captures: {1: punctuation.definition.raw.code-fence.begin.markdown, 2: constant.other.language-name.markdown}
      embed: scope:source.nginx
      embed_scope: markup.raw.code-fence.nginx.markdown-gfm
      escape: '{{fence_end}}'
      escape_captures: {1: punctuation.definition.raw.code-fence.end.markdown}
